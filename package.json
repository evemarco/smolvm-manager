{
  "name": "smolvm-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000 --strictPort",
    "dev:manager": "bun run scripts/start-manager.ts",
    "dev:pylon": "pylon dev app.ts",
    "build": "vite build",
    "start:manager": "bun run scripts/start-manager.ts --prod",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:docker-hub-e2e": "DOCKER_HUB_E2E=true bun test src/lib/server/docker-hub.e2e.test.ts",
    "gate": "bun run scripts/quality-gate.ts",
    "admin:reset": "bun run scripts/reset-admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vite-pwa/sveltekit": "^1.1.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@lucide/svelte": "^1.27.0",
    "@pylonsync/functions": "0.3.333",
    "@pylonsync/sdk": "0.3.333",
    "@pylonsync/sync": "0.3.333",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
