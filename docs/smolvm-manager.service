[Unit]
Description=SmolVM Manager web UI
After=network.target smolvm-serve.service
Wants=smolvm-serve.service

[Service]
Type=simple
User=smolvm-manager
Group=smolvm-manager
WorkingDirectory=/var/lib/smolvm-manager
EnvironmentFile=/etc/smolvm-manager/env
ExecStart=/usr/local/bin/bun run scripts/start-manager.ts --prod
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Security hardening
# NoNewPrivileges must stay off: the SmolVM update CLI is elevated through a
# narrowly scoped sudoers rule (see docs/DEPLOYMENT.md) because resource
# updates require root access to per-VM cache dirs owned by mapped uids.
ProtectSystem=strict
ProtectHome=true
# The SmolVM CLI update path writes the same SQLite store used by
# smolvm-serve.service and touches per-VM cache dirs; both run as root via the
# sudoers rule, these entries only relax the unit mount namespace.
ReadWritePaths=/var/lib/smolvm-manager /var/lib/smolvm/.local/share/smolvm/server /var/lib/smolvm/.cache/smolvm

[Install]
WantedBy=multi-user.target
