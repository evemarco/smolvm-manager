[Unit]
Description=SmolVM Manager web UI
After=network.target smolvm-serve.service
Wants=smolvm-serve.service

[Service]
Type=simple
User=smolvm-manager
Group=smolvm-manager
WorkingDirectory=/var/lib/smolvm-manager
EnvironmentFile=/etc/smolvm-manager/env
ExecStart=/usr/local/bin/bun run scripts/start-manager.ts --prod
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The SmolVM CLI update path writes the same SQLite store used by
# smolvm-serve.service. Keep this path narrow and grant filesystem permissions
# to the smolvm-manager user/group when SMOLVM_UPDATE_HOME=/var/lib/smolvm.
ReadWritePaths=/var/lib/smolvm-manager /var/lib/smolvm/.local/share/smolvm/server

[Install]
WantedBy=multi-user.target
