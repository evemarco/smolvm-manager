+/// Plain env of a looked-up [`VmRecord`] for exec/run handlers.
+///
+/// CLI `machine exec` merges the record's persisted plain env
+/// (`record_env_with_secrets`); HTTP exec/run handlers use this to match
+/// that behavior. `None` (machine without a record) contributes nothing.
+pub(crate) fn record_plain_env(
+    record: Option<&crate::config::VmRecord>,
+) -> Vec<(String, String)> {
+    record.map(|r| r.env.clone()).unwrap_or_default()
+}
